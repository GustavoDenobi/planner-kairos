# Supabase — local: run `npx supabase start` and copy values from output
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public URL of the web app (used in Open Graph / WhatsApp link previews)
# Local dev: http://localhost:5173
# Production: https://your-domain.com
VITE_APP_URL=http://localhost:5173

# SMTP for Edge Functions (password recovery) — set via `supabase secrets set` or supabase/.env
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@kairos.local
# SMTP_SECURE=false
